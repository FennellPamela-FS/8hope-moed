# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Bible API (scripture.api.bible)
VITE_BIBLE_API_KEY=your-bible-api-key

# Note: Gemini AI generation now runs server-side in the daily-verses edge
# function (GEMINI_API_KEY + BIBLE_API_KEY set via `supabase secrets set`),
# not in the client bundle. No VITE_GEMINI_API_KEY needed here anymore.

# App
VITE_APP_URL=http://localhost:5173
